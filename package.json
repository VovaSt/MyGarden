{
  "name": "mygarden",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "backend:build": "npm run build --workspace=@mygarden/backend",
    "backend:start": "npm run start --workspace=@mygarden/backend",
    "backend:start:dev": "npm run start:dev --workspace=@mygarden/backend",
    "frontend:build": "npm run build --workspace=@mygarden/frontend",
    "frontend:start": "npm run start --workspace=@mygarden/frontend",
    "frontend:test": "npm run test --workspace=@mygarden/frontend",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
